{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strata",
  "version": "1.0.0",
  "identifier": "io.github.kasempiternal.strata",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Strata",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Kasempiternal",
    "copyright": "Copyright (c) 2026 Kasempiternal. MIT License.",
    "homepage": "https://kasempiternal.github.io/strata/",
    "category": "Utility",
    "shortDescription": "See where your disk space went. In seconds.",
    "longDescription": "Strata is a blazing fast disk space analyzer for Windows. It reads the NTFS Master File Table directly to map millions of files in seconds, shows them as an interactive sunburst, and lets you safely clean up what you no longer need.",
    "licenseFile": "../LICENSE"
  }
}
